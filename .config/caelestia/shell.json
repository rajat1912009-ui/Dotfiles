    "launcher": {
        "actions": [
            {
                "command": [
                    "autocomplete",
                    "calc"
                ],
                "dangerous": false,
                "description": "Evaluate a math expression",
                "enabled": true,
                "icon": "function",
                "name": "Calculator"
            },
            {
                "command": [
                    "autocomplete",
                    "scheme"
                ],
                "dangerous": false,
                "description": "Pick a colour scheme",
                "enabled": true,
                "icon": "palette",
                "name": "Scheme"
            },
            {
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "dangerous": false,
                "description": "Browse and set wallpapers",
                "enabled": true,
                "icon": "wallpaper",
                "name": "Wallpapers"
            },
            {
                "command": [
                    "autocomplete",
                    "variant"
                ],
                "dangerous": false,
                "description": "Pick a material variant",
                "enabled": true,
                "icon": "style",
                "name": "Variant"
            },
            {
                "command": [
                    "autocomplete",
                    "clipboard"
                ],
                "dangerous": false,
                "description": "Browse clipboard history",
                "enabled": true,
                "icon": "content_paste",
                "name": "Clipboard"
            },
            {
                "command": [
                    "autocomplete",
                    "emoji"
                ],
                "dangerous": false,
                "description": "Browse emoji and symbols",
                "enabled": true,
                "icon": "insert_emoticon",
                "name": "Emoji"
            },
            {
                "command": [
                    "autocomplete",
                    "keybinds"
                ],
                "dangerous": false,
                "description": "View keyboard shortcuts",
                "enabled": true,
                "icon": "keyboard",
                "name": "Keybinds"
            },
            {
                "command": [
                    "caelestia",
                    "shell",
                    "nexus",
                    "open"
                ],
                "dangerous": false,
                "description": "Open caelestia settings",
                "enabled": true,
                "icon": "settings",
                "name": "Settings"
            },
            {
                "command": [
                    "setMode",
                    "dark"
                ],
                "dangerous": false,
                "description": "Switch to dark mode",
                "enabled": true,
                "icon": "dark_mode",
                "name": "Dark"
            },
            {
                "command": [
                    "setMode",
                    "light"
                ],
                "dangerous": false,
                "description": "Switch to light mode",
                "enabled": true,
                "icon": "light_mode",
                "name": "Light"
            },
            {
                "command": [
                    "caelestia",
                    "scheme",
                    "set",
                    "-r"
                ],
                "dangerous": false,
                "description": "Pick a random colour scheme",
                "enabled": true,
                "icon": "shuffle",
                "name": "Random"
            },
            {
                "command": [
                    "loginctl",
                    "lock-session"
                ],
                "dangerous": false,
                "description": "Lock the screen",
                "enabled": true,
                "icon": "lock",
                "name": "Lock"
            },
            {
                "command": [
                    "sh",
                    "-c",
                    "loginctl terminate-session $XDG_SESSION_ID"
                ],
                "dangerous": true,
                "description": "Log out of the session",
                "enabled": true,
                "icon": "logout",
                "name": "Logout"
            },
            {
                "command": [
                    "systemctl",
                    "reboot"
                ],
                "dangerous": true,
                "description": "Reboot the computer",
                "enabled": true,
                "icon": "restart_alt",
                "name": "Reboot"
            },
            {
                "command": [
                    "systemctl",
                    "poweroff"
                ],
                "dangerous": true,
                "description": "Power off the computer",
                "enabled": true,
                "icon": "power_settings_new",
                "name": "Shutdown"
            },
            {
                "command": [
                    "systemctl",
                    "suspend"
                ],
                "dangerous": true,
                "description": "Suspend the computer",
                "enabled": true,
                "icon": "bedtime",
                "name": "Sleep"
            }
        ],
        "enableDangerousActions": true,
