{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",


    "logo": {
        "source": "~/.config/fastfetch/bocchi_final.ansi",
        "type": "file",
        "height": 22,
        "padding": {
            "top": 3
        }
    },

    "display": {
        "separator": " ➜ ",
        "key": {
            "width": 10 // <-- TWEAK THIS: Forces all keys (OS, ├ , etc.) to be exactly this wide. Ensures the "➜" lines up perfectly straight.
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "custom",
            // Uses standard ANSI escapes (\u001b[31m = Red, \u001b[32m = Green, etc.) to pull directly from Kitty's active palette
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
        "break",
        {
            "type": "title",
            "keyWidth": 8
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
        },
        "break",
        // --- SYSTEM GROUP (Red Theme) ---
        { "type": "os",       "key": " OS   ", "keyColor": "red" },
        { "type": "kernel",   "key": " ├   ", "keyColor": "red" },
        { "type": "packages", "key": " ├   ", "keyColor": "red", "format": "{1} (pacman)" },
        { "type": "shell",    "key": " └   ", "keyColor": "red", "format": "{1}" },
        "break",

        // --- ENVIRONMENT GROUP (Green Theme) ---
        { "type": "wm",           "key": " WM   ", "keyColor": "green" },
        { "type": "wmtheme",      "key": " ├ 󰉼  ", "keyColor": "green" },
        { "type": "icons",        "key": " ├ 󰀻  ", "keyColor": "green" },
        { "type": "cursor",       "key": " ├   ", "keyColor": "green" },
        { "type": "terminal",     "key": " ├   ", "keyColor": "green" },
        { "type": "terminalfont", "key": " └   ", "keyColor": "green" },
        "break",
        
        // --- HARDWARE GROUP (Yellow Theme) ---
        { "type": "host",    "key": " PC   ", "keyColor": "yellow", "format": "{5} {1}" },
        { "type": "cpu",     "key": " ├   ", "keyColor": "yellow", "format": "{1} ({3}) @ {7}" },
        { "type": "gpu",     "key": " ├ 󰢮  ", "keyColor": "yellow", "format": "{2} @ {12}" },
        { "type": "memory",  "key": " ├   ", "keyColor": "yellow", "format": "{1} / {2}" },
        { "type": "swap",    "key": " ├ 󰓡  ", "keyColor": "yellow", "format": "{1} / {2}" },
        { "type": "disk",    "key": " ├ 󰋊  ", "keyColor": "yellow", "format": "{1} / {2}" },
        { "type": "monitor", "key": " └   ", "keyColor": "yellow", "format": "{1}x{2} @ {3}Hz" },
        "break",
        
        // --- TIME & CUSTOM GROUP (Blue Theme) ---
        { "type": "uptime",   "key": " UP   ", "keyColor": "blue" },
        { "type": "datetime", "key": " ├   ", "keyColor": "blue", "format": "{1}-{3}-{11}" },
        { "type": "command",  "key": " └   ", "keyColor": "blue", "text" : "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days" },
        "break",
        
       // { "type": "command",  "key": " SH   ", "keyColor": "magenta", "text": "hyprctl splash" },
        { "type": "custom",   "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
        "break",
        "break"
    ]
}
