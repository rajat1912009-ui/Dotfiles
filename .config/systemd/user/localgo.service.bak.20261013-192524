[Unit]
Description=LocalGo LocalSend receiver (headless, IPC enabled)
Documentation=https://github.com/bethropolis/localgo
After=network.target

[Service]
Type=simple
# Installed by install.sh - edit the paths here if you move things around.
ExecStart=/home/ciel/.local/bin/localgo serve --ipc --quiet --dir /home/ciel/Downloads
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
